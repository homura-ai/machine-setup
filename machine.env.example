# Settings for setup-new-machine.sh. Copy to machine.env and edit. No secrets here.
DEST_HOST=new-laptop            # SSH host name of the destination (or --host)
DEST_USER=$(id -un)             # destination user (default: same as here)
# DEST_HOME=/home/$DEST_USER
SSH_IDENTITY=$HOME/.ssh/id_ed25519
# SRC_HOME=$HOME                # where the installed versions live on this machine
FEDORA_VERSION=45
# Installed versions to copy (names of the existing folders/files on this machine).
# Example values; use the folder and file names installed on your machine.
CLAUDE_VERSION=2.1.319                              # ~/.local/share/claude/versions/<this>
CODEX_RELEASE=0.167.0-x86_64-unknown-linux-musl     # ~/.codex/packages/standalone/releases/<this>
T3_APPIMAGE=T3-Code-0.1.7-x86_64.AppImage           # ~/app/<this>
REPO_SRC=$HOME/code/my-project                      # one Git repo to copy (with nested repos)
# REPO_DEST=/home/$DEST_USER/code/my-project
# Nested repos inside REPO_SRC whose Git status must match exactly (colon-separated folder names).
# VERIFY_EXACT_STATUS=research-a:research-b
